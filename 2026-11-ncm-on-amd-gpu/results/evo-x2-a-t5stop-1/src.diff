+if a.time:
+    # Timing mode (lab patch): same model, settings and decoding as run(), one article per request.
+    import csv, json, random, time
+    assert not UNCOND, "timing mode needs a conditional task (articles as input)"
+    arts = random.Random(a.time_seed).sample(range(len(items)), min(a.time_n, len(items)))
+    out_dir = os.path.dirname(os.path.abspath(a.out))
+    os.makedirs(out_dir, exist_ok=True)
+    with open(os.path.join(out_dir, "articles.txt"), "w") as f:
+        f.write("\n".join(map(str, arts)) + "\n")
+
+    def tick():
+        torch.cuda.synchronize()
+        return time.perf_counter()
+
+    def one(i):
+        x = torch.tensor([prefix(items[i])], device="cuda")
+        net.timing = [] if a.time_passes else None
+        with torch.no_grad(), torch.autocast(device_type="cuda", dtype=torch.bfloat16, enabled=a.bf16):
+            t0 = tick()
+            g = net.generate(None, x, temperature=temp, top_k=top_k, top_p=top_p, cfg_scale=cfg, cfg_null_eos=EOS)
+            t1 = tick()
+            _, zl = tk.vqvae.vq.idx_to_zhats(g, return_zlevels=True)
+            t2 = tick()
+            logits = tk.vqvae.decoder(zl[-1])
+            t3 = tick()
+            ids = pick_tokens(logits).tolist()
+            t4 = tick()
+        text = dec(ids[0])
+        t5 = time.perf_counter()
+        marks = [t for _, t in (net.timing or [])]
+        net.timing = None
+        ms = lambda s, e: round((e - s) * 1e3, 3)
+        return {
+            "article": i, "ts": round(time.time(), 3),
+            "total_ms": ms(t0, t5), "generate_ms": ms(t0, t1), "zhats_ms": ms(t1, t2),
+            "decoder_ms": ms(t2, t3), "pick_ms": ms(t3, t4), "dec_ms": ms(t4, t5),
+            "prefix_ms": ms(marks[0], marks[1]) if len(marks) > 1 else "",
+            "pass_ms": ";".join(str(ms(s, e)) for s, e in zip(marks[1:], marks[2:])),
+            "mem_alloc_mb": round(torch.cuda.memory_allocated() / 2**20, 1),
+            "mem_reserved_mb": round(torch.cuda.memory_reserved() / 2**20, 1),
+            "summary": text,
+        }
+
+    w0, nw = time.perf_counter(), 0
+    while time.perf_counter() - w0 < a.warmup_s:
