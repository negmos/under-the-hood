+    warm_s = time.perf_counter() - w0
+    print(f"  warm-up: {nw} requests in {warm_s:.1f} s (discarded)", flush=True)
+
+    fields = ["req", "article", "ts", "total_ms", "generate_ms", "zhats_ms", "decoder_ms", "pick_ms", "dec_ms",
